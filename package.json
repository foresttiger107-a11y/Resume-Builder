{
  "name": "resume-builder",
  "version": "4.2.1",
  "description": "Resume Builder — build tailored resumes with ChatGPT and Word export.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bump": "node scripts/bump-version.cjs",
    "build": "electron-builder --win",
    "release": "npm run bump && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.resumebuilder.app",
    "productName": "Resume Builder",
    "icon": "assets/icon.png",
    "files": [
      "**/*",
      "!dist/**"
    ],
    "asarUnpack": [
      "prompt/**"
    ],
    "afterPack": "./scripts/after-pack-icon.cjs",
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "docx-preview": "^0.3.7",
    "docxtemplater": "^3.68.7",
    "node-global-key-listener": "^0.3.0",
    "pizzip": "^3.2.0"
  }
}
