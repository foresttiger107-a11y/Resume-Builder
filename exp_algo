// exp_algo — maps to "Justin Mcghee structure.docx" (Docxtemplater)
//
// {#work_experience} … {/work_experience}
//   Bold:   {role_title} | {company}
//   Normal: {location_line}     ← built as " | Middletown, DW, US (Remote)" from JSON
//   Right:  {duration}          (tab stop in template)
//   {#bullet_points} • {bullet} {/bullet_points}
//
// JSON fields per job:
//   role_title, company, location, location_type, duration, bullet_points[]
//
// Do NOT use {work_experience} without # (array → [object Object],…).
// Optional combined city+mode only: {place}  (e.g. "Los Angeles, CA, US (Hybrid)")
//
for (const exp of work_experience) {
  const locationLine =
    exp.location && exp.location_type
      ? " | " + exp.location + " (" + exp.location_type + ")"
      : exp.location
        ? " | " + exp.location
        : exp.location_type
          ? " | (" + exp.location_type + ")"
          : "";
  print(exp.role_title + " | " + exp.company + locationLine + "\t" + exp.duration);
  for (const bullet of exp.bullet_points) {
    print("  - " + bullet);
  }
}
